/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test (stub run)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Checks the pipeline wiring with placeholder data. Run from the repository root:

        nextflow run . -profile test -stub --outdir results_test

    A real test needs a (small) GT-Pro database; see docs/usage.md.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal stub test to check pipeline wiring'

    input             = "${projectDir}/tests/data/samplesheet.csv"
    host_fasta        = "${projectDir}/tests/data/host.fasta"
    run_coverm        = true
    abundance_genomes = "${projectDir}/tests/data/genomes"
    gtpro_db          = "${projectDir}/tests/data/gtpro_db"
    gtpro_snp_dict    = "${projectDir}/tests/data/snp_dict.tsv"
    species_bins      = 8
}
