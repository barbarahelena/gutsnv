/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Publishing is handled by the `output` block in main.nf, not by publishDir.
    Available keys to override module options:
        ext.args   = Additional arguments appended to the tool command
        ext.prefix = File name prefix for output files
----------------------------------------------------------------------------------------
*/

process {

    withName: 'FASTQC' {
        ext.args = '--quiet'
    }

    // Equivalent of the Trimmomatic settings in Wang et al. 2026 (SLIDINGWINDOW:4:20 MINLEN:50)
    withName: 'FASTP' {
        ext.args = '--cut_right --cut_window_size 4 --cut_mean_quality 20 --length_required 50'
    }

    // KneadData default Bowtie2 settings
    withName: 'BOWTIE2_HOSTREMOVAL' {
        ext.args = '--very-sensitive-local'
    }

    withName: 'COVERM_GENOME' {
        ext.args = '--methods relative_abundance'
    }

    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    }
}
